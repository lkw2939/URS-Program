# Set local values; existing environment variables take precedence.
URS_OPENAI_API_KEY=
URS_OPENAI_MODEL=
# Per execution cap, not a cumulative document budget.
URS_AI_BUDGET_USD=
URS_AI_INPUT_USD_PER_MILLION=
URS_AI_OUTPUT_USD_PER_MILLION=

# Optional; blank omits reasoning.effort. Model support must be confirmed by API.
URS_OPENAI_REASONING_EFFORT=

# Optional default output limit; blank uses 5000. Web settings take priority.
URS_OPENAI_MAX_OUTPUT_TOKENS=

# Report-only socket I/O timeout, seconds; blank uses 600. Web setting takes precedence.
URS_OPENAI_REPORT_TIMEOUT_SECONDS=

# Optional verified cached-input price per million tokens; blank leaves cached usage unsettled.
URS_AI_CACHED_INPUT_USD_PER_MILLION=
