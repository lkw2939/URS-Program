{
  "scope": "Synthetic PDF, fixture model, mocked transport; no authentication headers or real customer data",
  "payload": {
    "model": "fixture-terra",
    "input": [
      {
        "role": "user",
        "content": [
          {
            "type": "input_file",
            "filename": "synthetic.pdf",
            "file_data": "data:application/pdf;base64,"
          },
          {
            "type": "input_text",
            "text": "  내 프롬프트 원문\nHTML/CSS와 번역은 직접 작성하세요.\n  "
          },
          {
            "type": "input_text",
            "text": "Image address mapping only: use <img src=\"urs-image:PAGE:INDEX\"> for a source picture/diagram at the corresponding original PDF page and region. Available image addresses and bounding boxes (PDF points from top-left):\n[{\"uri\": \"urs-image:1:1\", \"page\": 1, \"index\": 1, \"bbox\": [20.0, 100.0, 120.0, 200.0]}, {\"uri\": \"urs-image:1:2\", \"page\": 1, \"index\": 2, \"bbox\": [220.0, 100.0, 320.0, 200.0]}]"
          }
        ]
      }
    ],
    "max_output_tokens": 5000,
    "store": false
  }
}
